r-2","sha256":"99ba72a67a5896541964d778f2e6446c7c661cd39259aba8fe4fa0531715beb3","source_url":"https://pmt.physicsandmathstutor.com/download/Physics/A-level/Past-Papers/AQA/Paper-2/MS/June 2024 MS.pdf","local_path":"papers/aqa/current-A-level/2024/June-2024-MS--99ba72a67a.pdf","level":"external","qualification":"current-A-level","collection":"supplementary","collection_label":"Extra question banks","syllabus":"IB Physics, first assessment 2025","paper_label":"Paper-2"}},"given_text":"G = 6.67 × 10⁻¹¹ N m² kg⁻²."}],"contexts":[]},{"id":"cross-aq24p2-23","question_number":23,"question_type":"mcq","ib_level":"HL","source":{"course":"current-A-level","level":"external","year":2024,"session":"June","collection":"supplementary","collection_label":"Extra question banks","paper":"Paper-2","paper_label":"Paper-2","syllabus":"IB Physics, first assessment 2025"},"parts":[{"label":"whole","marks":1,"review_status":"reviewed","subtopic_ids":["D.1"],"depends_on":[],"context_ids":[],"display_text":null,"assets":[{"path":"cross-board-assets/aq24p2-23-0.webp","dpi":144,"crop_pdf_points_top_left":[0,0,443.5,436.5],"source_pdf_page":30,"source_crop":[82,62.765106201171875,537,522.68505859375],"sha256":"e17cffaefa6eab59a7707bb208398eb5ab872b4438ecdafee35e7ad78ee19b70"}],"answer":{"text":"Correct answer: D.","letter":"D","source_id":"aqa-7c5cb2a250e8d90d","pdf_page":26,"evidence":"23       D          The work done moving from Q to R and moving from Q to S is the same.","source":{"id":"aqa-7c5cb2a250e8d90d","board":"aqa","course":"current-A-level","year":2024,"session":"June","paper":"Paper-2","sha256":"99ba72a67a5896541964d778f2e6446c7c661cd39259aba8fe4fa0531715beb3","source_url":"https://pmt.physicsandmathstutor.com/download/Physics/A-level/Past-Papers/AQA/Paper-2/MS/June 2024 MS.pdf","local_path":"papers/aqa/current-A-level/2024/June-2024-MS--99ba72a67a.pdf","level":"external","qualification":"current-A-level","collection":"supplementary","collection_label":"Extra question banks","syllabus":"IB Physics, first assessment 2025","paper_label":"Paper-2"}},"given_text":null}],"contexts":[]},{"id":"cross-oc24p1-14","question_number":14,"question_type":"mcq","ib_level":"HL","source":{"course":"current-A-level","level":"external","year":2024,"session":"June","collection":"supplementary","collection_label":"Extra question banks","paper":"Paper-1","paper_label":"Paper-1","syllabus":"IB Physics, first assessment 2025"},"parts":[{"label":"whole","marks":1,"review_status":"reviewed","subtopic_ids":["D.1"],"depends_on":[],"context_ids":[],"display_text":null,"assets":[{"path":"cross-board-assets/oc24p1-14-0.webp","dpi":144,"crop_pdf_points_top_left":[0,0,450.5,161.5],"source_pdf_page":10,"source_crop":[40,57.58944320678711,565.2760009765625,221.03045654296875],"sha256":"447b4872ffe0ef7858e2611f904ac9a012fb54c8e70458b0526209bc0fa28ff5"}],"answer":{"text":"Correct answer: C.","letter":"C","source_id":"ocr-79d7fd5bd68f9230","pdf_page":10,"evidence":"14   C                                                  1","source":{"id":"ocr-79d7fd5bd68f9230","board":"ocr","course":"current-A-level","year":2024,"session":"June","paper":"Paper-1","sha256":"8af74974c19755b5bfa6148ac880e63c09caa8195e42fb341d37c0e404590205","source_url":"https://pmt.physicsandmathstutor.com/download/Physics/A-level/Past-Papers/OCR-A/Paper-1/MS/June 2024 MS.pdf","local_path":"papers/ocr/current-A-level/2024/June-2024-MS--8af74974c1.pdf","level":"external","qualification":"current-A-level","collection":"supplementary","collection_label":"Extra question banks","syllabus":"IB Physics, first assessment 2025","paper_label":"Paper-1"}},"given_text":null}],"contexts":[]},{"id":"cross-ca24m4-written-1a","question_number":"1a","question_type":"written","ib_level":"HL","source":{"course":"9702","level":"external","year":2024,"session":"March","collection":"supplementary","collection_label":"Extra question banks","paper":"42","paper_label":"42","syllabus":"IB Physics, first assessment 2025"},"parts":[{"label":"whole","marks":null,"review_status":"reviewed","subtopic_ids":["D.1"],"depends_on":[],"context_ids":[],"display_text":"Explain why gravitational potential near an isolated point mass is negative.","assets":[],"answer":{"text":"Gravitational potential is defined as zero at infinity. Gravity is attractive, so positive external work per unit mass is needed to move a test mass from the point to infinity. Its initial potential is therefore below zero.","source_id":"cambridge-a2643bb4c378f550","evidence":{"question":"1a","pages":[6],"review":"Worked answer checked against the source marking guidance; wording adapted for independent IB practice."},"source":{"id":"cambridge-a2643bb4c378f550","board":"cambridge","course":"9702","year":2024,"session":"March","paper":"42","sha256":"ea108d62044d9875829c5d40370d45642d78f217f68b9f48a5b8a81d7787b05c","source_url":"https://pastpapers.papacambridge.com/directories/CAIE/CAIE-pastpapers/upload/9702_m24_ms_42.pdf","local_path":"papers/cambridge/9702/2024/9702_m24_ms_42--ea108d6204.pdf","level":"external","qualification":"9702","collection":"supplementary","collection_label":"Extra question banks","syllabus":"IB Physics, first assessment 2025","paper_label":"42"}},"given_text":null}],"contexts":[]},{"id":"cross-ca24m4-written-1biii","question_number":"1biii","question_type":"written","ib_level":"HL","source":{"course":"9702","level":"external","year":2024,"session":"March","collection":"supplementary","collection_label":"Extra question banks","paper":"42","paper_label":"42","syllabus":"IB Physics, first assessment 2025"},"parts":[{"label":"whole","marks":null,"review_status":"reviewed","subtopic_ids":["D.1"],"depends_on":[],"context_ids":[],"display_text":"A satellite of mass 1200 kg moves at 8400 m s⁻¹ in a circular orbit of radius 8.3 × 10⁷ m around a planet of mass 8.8 × 10²⁵ kg. Calculate the minimum additional energy needed for the satellite to reach infinity. Use G = 6.67 × 10⁻¹¹ N m² kg⁻².","assets":[],"answer":{"text":"At infinity the minimum final total energy is zero. Initially E = ½mv² − GMm/r. The required addition is GMm/r − ½mv² ≈ 4.3 × 10¹⁰ J.","source_id":"cambridge-a2643bb4c378f550","evidence":{"question":"1biii","pages":[6],"review":"Worked answer checked against the source marking guidance; wording adapted for independent IB practice."},"source":{"id":"cambridge-a2643bb4c378f550","board":"cambridge","course":"9702","year":2024,"session":"March","paper":"42","sha256":"ea108d62044d9875829c5d40370d45642d78f217f68b9f48a5b8a81d7787b05c","source_url":"https://pastpapers.papacambridge.com/directories/CAIE/CAIE-pastpapers/upload/9702_m24_ms_42.pdf","local_path":"papers/cambridge/9702/2024/9702_m24_ms_42--ea108d6204.pdf","level":"external","qualification":"9702","collection":"supplementary","collection_label":"Extra question banks","syllabus":"IB Physics, first assessment 2025","paper_label":"42"}},"given_text":null}],"contexts":[]}],"guidance":{"entries":{"fep-6b5c443f4c508e3a-q10:whole":{"hint":"Draw the direction towards each attracting mass and measure distances from the centres of the masses.","notes":["Outside a spherical mass, g = GM/r² and F = mg. Add field contributions as vectors when more than one mass is present.","An altitude above a surface is not the radius in the formula: r = R + h. The test mass affects force but not the field strength at its position."]},"fep-6b5c443f4c508e3a-q12:whole":{"hint":"For a circular orbit, gravity supplies the inward acceleration. Use the radius measured from the central body’s centre.","notes":["Equating GMm/r² = mv²/r gives v = √(GM/r), then T = 2πr/v. This leads to T² proportional to r³.","Orbiting objects are in free fall, not outside gravity. A geostationary orbit must also be equatorial, prograde and have Earth’s rotation period."]},"fep-ef78ee429e32d095-q14:whole":{"hint":"For a circular orbit, gravity supplies the inward acceleration. Use the radius measured from the central body’s centre.","notes":["Equating GMm/r² = mv²/r gives v = √(GM/r), then T = 2πr/v. This leads to T² proportional to r³.","Orbiting objects are in free fall, not outside gravity. A geostationary orbit must also be equatorial, prograde and have Earth’s rotation period."]},"fep-00ad3c02d9eb1c75-q13:whole":{"hint":"Look for a point where the two field contributions have opposite directions before equating their magnitudes.","notes":["At a gravitational field null between two masses, GM₁/r₁² = GM₂/r₂², with r₁ + r₂ equal to their separation.","The point lies closer to the smaller mass. Zero field does not imply zero potential, because potential contributions add as signed scalars."]},"fep-00ad3c02d9eb1c75-q14:whole":{"hint":"Distinguish energy per kilogram from the energy of the whole object.","notes":["With zero at infinity, gravitational potential is V_g = −GM/r and potential energy is mV_g. Work required for a slow move is m(V_final − V_initial).","Potential is a scalar, so add its contributions algebraically. Use mgΔh only for a small height change where g is approximately uniform."]},"fep-087cdb86efe01a8d-q12:whole":{"hint":"Distinguish energy per kilogram from the energy of the whole object.","notes":["With zero at infinity, gravitational potential is V_g = −GM/r and potential energy is mV_g. Work required for a slow move is m(V_final − V_initial).","Potential is a scalar, so add its contributions algebraically. Use mgΔh only for a small height change where g is approximately uniform."]},"fep-087cdb86efe01a8d-q13:whole":{"hint":"For a circular orbit, gravity supplies the inward acceleration. Use the radius measured from the central body’s centre.","notes":["Equating GMm/r² = mv²/r gives v = √(GM/r), then T = 2πr/v. This leads to T² proportional to r³.","Orbiting objects are in free fall, not outside gravity. A geostationary orbit must also be equatorial, prograde and have Earth’s rotation period."]},"fep-2403e98c534d299c-q11:whole":{"hint":"Distinguish energy per kilogram from the energy of the whole object.","notes":["