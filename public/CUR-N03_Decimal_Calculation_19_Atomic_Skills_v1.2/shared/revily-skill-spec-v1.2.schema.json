{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revily.local/schemas/revily-skill-spec-v1.2.schema.json",
  "title": "Revily Skill Specification v1.2",
  "type": "object",
  "required": [
    "schema_version",
    "spec_intent",
    "identity",
    "curriculum",
    "dependencies",
    "engine_capability_requirements",
    "experience_contract",
    "voice_and_script",
    "visual_language",
    "diagnostic",
    "concept_model",
    "lesson",
    "completion",
    "question_bank",
    "progress_and_persistence",
    "analytics_events",
    "qa"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "identity": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "title",
        "strand",
        "cluster",
        "tier",
        "status",
        "estimated_minutes"
      ]
    },
    "curriculum": {
      "type": "object",
      "required": [
        "basis",
        "role",
        "official_mapping",
        "learning_objective",
        "success_criteria",
        "boundaries"
      ]
    },
    "dependencies": {
      "type": "object",
      "required": [
        "required_skill_refs",
        "entry_assumptions",
        "downstream_rule"
      ]
    },
    "experience_contract": {
      "type": "object",
      "required": [
        "target_session_minutes",
        "ordered_phases",
        "navigation",
        "global_ui_copy",
        "progress_indicator",
        "interaction_rules"
      ]
    },
    "voice_and_script": {
      "type": "object",
      "required": [
        "performer_name",
        "dialogue_profile_ref",
        "script_ownership",
        "delivery_style",
        "success_reaction_policy",
        "adjacent_speech_policy",
        "caption_policy"
      ]
    },
    "visual_language": {
      "type": "object",
      "required": [
        "scene_rules",
        "semantic_roles",
        "style_direction",
        "reduced_motion"
      ]
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "purpose",
        "question_refs",
        "presentation",
        "scoring",
        "routing"
      ]
    },
    "concept_model": {
      "type": "object",
      "required": [
        "core_idea",
        "invariant",
        "mathematical_rule",
        "vocabulary",
        "must_notice",
        "common_confusions"
      ]
    },
    "lesson": {
      "type": "object",
      "required": [
        "teaching_steps",
        "transfer_steps",
        "practice",
        "exit"
      ]
    },
    "completion": {
      "type": "object",
      "required": [
        "secure",
        "needs_work"
      ]
    },
    "question_bank": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "stage",
          "target",
          "ao",
          "difficulty",
          "prompt",
          "response",
          "answer",
          "attempt_policy",
          "success_reaction",
          "scripts",
          "mathematical_support",
          "branching"
        ],
        "properties": {
          "ao": {
            "enum": [
              "AO1",
              "AO2",
              "AO3"
            ]
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "response": {
            "type": "object",
            "required": [
              "type",
              "keyboard_submit"
            ]
          },
          "answer": {
            "type": "object",
            "required": [
              "value"
            ]
          },
          "scripts": {
            "type": "object",
            "required": [
              "on_correct_math",
              "on_incorrect_attempt_1",
              "on_incorrect_attempt_2",
              "worked_explanation"
            ]
          },
          "mathematical_support": {
            "type": "object",
            "required": [
              "hint_1",
              "hint_2",
              "worked_solution"
            ]
          },
          "success_reaction": {
            "type": "object",
            "required": [
              "mode",
              "context_override",
              "selection_rule"
            ]
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "required": [
        "schema_validated",
        "maths_answers_verified",
        "curriculum_human_reviewed",
        "scripts_human_reviewed",
        "animation_storyboard_human_reviewed",
        "branching_reference_validated",
        "engine_render_tested",
        "reduced_motion_tested",
        "keyboard_accessibility_tested",
        "student_calibration_tested",
        "acceptance_criteria"
      ]
    }
  }
}